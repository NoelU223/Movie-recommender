{
  "id": null,
  "uid": null,
  "title": "Movie Recommender – Monitoring",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Backend UP",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        { "refId": "A", "expr": "up" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Latency P95",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_highr_seconds_bucket[5m])) by (le))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Error rate (4xx + 5xx)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend RAM (RSS)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "title": "Backend CPU usage",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "cfagk2ihtg268a" },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total[5m])" }
      ],
      "fieldConfig": { "defaults": { "unit": "cores" } }
    }
  ]
}
