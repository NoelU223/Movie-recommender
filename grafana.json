{
  "dashboard": {
    "title": "Movie Recommender - Faza 3",
    "panels": [
      {
        "title": "HTTP Request Duration P95",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))"
          }
        ]
      },
      {
        "title": "Requests per second",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count[5m]))"
          }
        ]
      },
      {
        "title": "Cache Hit Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "1 - sum(rate(redis_cache_misses_total[5m])) / sum(rate(redis_cache_total[5m]))"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  },
  "overwrite": true
}
